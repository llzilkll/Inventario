{
  "name": "inventario-san-martin-seguridad",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:rules": "firebase emulators:exec --only firestore,database --project demo-inventario-sm \"node --test\"",
    "test": "firebase emulators:exec --only firestore,database,auth,functions --project demo-inventario-sm \"node --test --test-concurrency=1\"",
