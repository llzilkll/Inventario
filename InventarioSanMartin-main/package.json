  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.6.1",
    "firebase-admin": "^13.10.0",
    "firebase-tools": "^13.29.1",
    "puppeteer-core": "^25.3.0"
  }
}