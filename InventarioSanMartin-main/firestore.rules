rules_version = '2';

// Reglas de seguridad Firestore — Inventario San Martín
// Modelo: solo usuarios autenticados; escritura sensible restringida a rol admin.
// El rol vive en custom claims (request.auth.token.admin), asignado server-side.
// Nota: las Cloud Functions usan Admin SDK y omiten estas reglas por diseño.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    function isAdmin()    { return isSignedIn() && request.auth.token.admin == true; }
    function qtyValida()  {
      return !('cantidad' in request.resource.data)
          || (request.resource.data.cantidad is number && request.resource.data.cantidad >= 0);
    }

    // Perfiles de usuario (email, nombre, rol, activo). Alta/gestión solo vía Admin SDK.
    match /users/{uid} {
      allow read:   if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      // El propio usuario solo puede marcar su cambio de contraseña como realizado.
      allow update: if isSignedIn() && request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['debeCambiarPass'])
                    && request.resource.data.debeCambiarPass == false;
      allow create, delete: if false;
    }

    match /artifacts/{appId}/public/data/activos/{docId} {
      allow read:           if isSignedIn();
      allow create, update: if isSignedIn() && qtyValida();
      allow delete:         if isAdmin();
    }

    match /artifacts/{appId}/public/data/salidas_log/{docId} {
      allow read:           if isSignedIn();
      allow create:         if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /artifacts/{appId}/public/data/ordenes_scrap/{docId} {
      allow read:                  if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /artifacts/{appId}/public/data/ordenes_salida/{docId} {
      allow read:                  if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /artifacts/{appId}/public/data/publicaciones_armadas/{docId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // Cualquier otra ruta: denegada por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
